@model IEnumerable<OrderDetails>
@{
    ViewData["title"] = "Order Details";
    decimal total = 0; //store total amount
    decimal subtotal = 0;
}
<!DOCTYPE html>
<html>

<head>
    <meta name="viewport" content="width-devide-width" />
    <title>Index</title>
</head>


<body>
<h3>List Order</h3>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Order Code</th>
            <th scope="col">UserName</th>
            <th scope="col">Product Name</th>
            <th scope="col">Product Price</th>
            <th scope="col">Quantity</th>
            <th scope="col">Subtotal</th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
                subtotal = item.Quantity * item.Price;
                total += subtotal;
                <tr>
                    <input type="hidden" asp-for="@item.OrderCode" />
                    <th>@item.Id</th>
                    <th>@item.OrderCode</th>
                    <td>@item.UserName</td>
                    <th>@item.Product.Name</th>
                    <th>$@item.Price</th>
                    <th>@item.Quantity</th>
                    <th>@subtotal.ToString("C")</th>
    
            </tr>
        }
        <tr>
            <th colspan="5">Total:</th>
            <td>@total.ToString("C")</td>
            <td> <select class="form-control select-update-order">
                <option value="1">Đơn hàng mới </option>
                <option value="0">Đã xử lý </option>
            </select></td>
        </tr>


    </tbody>
</table>
</body>
</html>
@section Scripts{
    <script>
        $(document).ready(function(){
            $('.select-update-order').change(function(){
                var status = $(this).val();
                var ordercode = $('.getId').val();
                alert(status);
                alert(ordercode);

                $.ajax({
                    type:"POST",
                    url:"@Url.Action("UpdateOrder")",
                    data: {status: status,ordercode: ordercode},//send data to the server

                    success:function(result){
                        //handle successfull update
                        if(result.success){
                            //update ui or show success message
                            //console.log("Update successful");
                            Swal.fire("Cập nhập đơn hàng thành công");
                        }
                        else{
                            //handle error
                            Swal.fire("Cập nhập đơn hàng thất bại" + result.message);
                            //console.log("Update failed: " + result.message);
                        }
                    },
                    error: function(req,status,error){
                        console.error("Error updating order: ", error);
                    }
                });
            });
        });
    </script>
}